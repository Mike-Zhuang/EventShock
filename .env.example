# 正式域名。Caddy 检测到域名后会自动申请并续期 HTTPS 证书。
APP_DOMAIN=eventshock.mikezhuang.cn

# 应用运行参数。SQLite 数据固定保存在容器的 /data 持久卷中。
APP_ENV=production
LOG_LEVEL=INFO

# 默认由 Caddy 直连容器。完成宝塔 Nginx 站点接入后，服务器共享配置可改为：
# CADDY_UPSTREAM=host.docker.internal:18080
CADDY_UPSTREAM=app:8000

# 应用只绑定宿主机回环地址，供宝塔 Nginx 反代，不对公网开放。
EVENTSHOCK_APP_HOST_PORT=18000
