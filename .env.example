# 正式域名。Caddy 检测到域名后会自动申请并续期 HTTPS 证书。
APP_DOMAIN=eventshock.mikezhuang.cn

# 应用运行参数。SQLite 数据固定保存在容器的 /data 持久卷中。
APP_ENV=production
LOG_LEVEL=INFO

# 只读治理接口固定从持久卷读取该路径；值不得改为宿主机日志或密钥路径。
# GitHub 同步脚本以原子方式维护文件，应用本身不会通过接口写入。
EVENTSHOCK_DEPLOYMENT_STATUS_FILE=/data/deployment-status.json

# 默认由 Caddy 直连容器。完成宝塔 Nginx 站点接入后，服务器共享配置可改为：
# CADDY_UPSTREAM=host.docker.internal:18080
CADDY_UPSTREAM=app:8000

# 主机重启时最多等待完整上游链路就绪的秒数；超时后启动 Caddy 以保留 TLS 与错误可观测性。
CADDY_STARTUP_GATE_TIMEOUT_SECONDS=90

# 应用只绑定宿主机回环地址，供宝塔 Nginx 反代，不对公网开放。
EVENTSHOCK_APP_HOST_PORT=18000

# 登录与邮件配置。示例只包含非敏感占位值；正式服务器必须在 root 专用的
# /opt/eventshock/shared/.env 中替换，并把真实密钥写入下方独立目录。
EVENTSHOCK_AUTH_REQUIRED=true
EVENTSHOCK_AUTH_COOKIE_SECURE=true
EVENTSHOCK_ADMIN_EMAIL=admin@example.com
EVENTSHOCK_SMTP_HOST=smtp.example.com
EVENTSHOCK_SMTP_PORT=465
EVENTSHOCK_SMTP_USERNAME=sender@example.com
EVENTSHOCK_SMTP_SENDER=sender@example.com

# 该目录不会进入镜像。生产环境使用 /opt/eventshock/shared/secrets；本地若暂不
# 测试邮件登录，可显式关闭 EVENTSHOCK_AUTH_REQUIRED，仍不得提交任何密钥。
EVENTSHOCK_SECRETS_DIR=./.eventshock-secrets

# compose.yml 在容器内固定读取：
# /run/secrets/eventshock/auth-secret
# /run/secrets/eventshock/admin-api-key-encryption-key
# /run/secrets/eventshock/smtp-password
# 管理员 API Key 加密主密钥由部署脚本在服务器受限目录中幂等生成；
# 这个文件只加密数据库密文，不是任何模型供应商的 API Key。
# 管理员初始密码只允许临时保存为 admin-bootstrap-password.once，由部署脚本
# 经 stdin 消费并删除；不要在本文件中增加任何密码、Token 或 API Key。
